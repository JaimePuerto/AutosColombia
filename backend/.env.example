PORT=3001

# Conexión a MySQL.
# Cuenta de EJECUCIÓN de la aplicación: mínimo privilegio (sin DDL y sin poder
# modificar/eliminar auditoría ni históricos). Se aprovisiona con `npm run crear-usuarios-bd`.
DB_HOST=localhost
DB_PORT=3306
DB_USER=autoscolombia_app
DB_PASSWORD=
DB_NAME=autoscolombia

# Cuenta ADMINISTRATIVA. La usan el mantenimiento, las migraciones y el arnés E2E
# (crea una base efímera y aplica los scripts). El backend no la usa en operación normal.
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=

# Recuperación de contraseña por correo (RF-12).
# MAIL_PROVIDER=consola (por defecto) no envía correos reales: deja el enlace en la consola del
# servidor y no simula el envío. Para habilitar el envío real usa MAIL_PROVIDER=http y configura
# el endpoint y la clave del proveedor transaccional.
MAIL_PROVIDER=consola
MAIL_FROM=Sistema AutosColombia <no-reply@autoscolombia.local>
MAIL_API_URL=
MAIL_API_KEY=

# URL base del frontend usada para construir el enlace de recuperación.
APP_BASE_URL=http://localhost:5173

# Variables usadas SOLO por el aprovisionamiento de cuentas (`npm run crear-usuarios-bd`).
# No son necesarias para ejecutar el backend ni el arnés. No versionar valores reales.
# ADMIN_DB_USER=autoscolombia_admin
# ADMIN_DB_PASSWORD=
# APP_DB_USER=autoscolombia_app
# APP_DB_PASSWORD=
